@SolidClass = worldspawn : "Geometria Brutalista do Fosso de Hefesto"
[
    biome_id(string) : "ID do Bioma" : "fosso_de_hefesto"
    ambient_kelvin(float) : "Temperatura ambiente (K)" : "315.0"
]

@SolidClass color(217 78 31) = func_lead_door_10t : "Porta de Chumbo 10 Toneladas (Câmara de Despacho)"
[
    door_id(string) : "ID da Porta" : "camara_despacho_14"
    weight_tons(float) : "Peso (toneladas)" : "10.0"
    window_3p(float) : "Janela 3 jogadores (s)" : "20.0"
    window_2p(float) : "Janela 2 jogadores (s)" : "30.0"
    window_1p(float) : "Janela solo (s)" : "40.0"
]

@SolidClass color(255 179 0) = func_live_line : "Linha Viva Pressurizada (Doutrina do Fogo Mínimo)"
[
    pressure_pct(float) : "Pressão Real (%)" : "140.0"
    no_fire_radius(float) : "Raio de Trava de Arma (m)" : "3.5"
]

@PointClass size(-32 -32 0, 32 32 76) color(200 50 20) = func_valve_thermatek : "Válvula Mestra Therma-Tek (3 Leituras)"
[
    valve_number(string) : "Número no Topo (Olhar Phantom)" : "14"
    pressure_pct(float) : "Pressão (Olhar Goliath)" : "140.0"
    circuit_id(string) : "Circuito (Olhar Cipher)" : "SANGRIA_SETOR_7_BAIXO"
]

@PointClass size(-48 -48 0, 48 48 96) color(255 110 20) = func_sangria_chute : "Duto de Sangria (Setor 7-Baixo)"
[
    target_sector(string) : "Setor Destino" : "Setor 7-Baixo"
]

@PointClass size(-16 -16 -16, 16 16 16) color(255 179 0) = info_lore_gauge_140 : "Fragmento: Manômetro da Estação 14 (140%)"
[
    fragment_id(string) : "ID em fragments.json" : "manometro-da-estacao-14"
]

@PointClass size(-16 -16 -16, 16 16 16) color(217 78 31) = info_lore_clock_23 : "Planta de Lore: Relógio 23 Anos Riscado a Prego"
[
    years_remaining(integer) : "Anos restantes" : 23
]

@PointClass size(-16 -16 -16, 16 16 16) color(230 238 245) = info_lore_quota_tag : "Fragmento: Etiqueta de Cota Familiar"
[
    fragment_id(string) : "ID em fragments.json" : "etiqueta-de-cota"
