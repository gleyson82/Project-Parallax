{
  "mcpServers": {
    "daedalus-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/opt/Project-Parallax"
      ]
    },
    "parallax-unity": {
      "command": "unity",
      "args": [
        "mcp",
        "--project-path",
        "C:/opt/Project-Parallax/client/parallax-unity"
      ]
    },
    "blender-mcp": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ]
    },
    "comfyui": {
      "command": "C:\\ComfyUI\\venv\\Scripts\\python.exe",
      "args": [
        "C:\\ComfyUI\\mcp_server.py"
      ],
      "env": {
        "COMFYUI_URL": "http://127.0.0.1:8188",
        "COMFYUI_OUTPUT_DIR": "C:\\ComfyUI\\output_ide"
      }
    }
  }
}
